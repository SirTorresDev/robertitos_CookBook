{
  "expo": {
    "name": "Robertito´s CookBook",
    "slug": "robertitos-cookbook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/chef.png",
    "scheme": "robertitoscookbook",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/chef.png",
      "bundleIdentifier": "com.robertotorres.cookbook",
      "infoPlist": {
        "CFBundleDisplayName": "Robertito´s CookBook",
        "NSCameraUsageDescription": "Robertito´s CookBook utiliza la cámara para fotografiar y escanear recetas o platos.",
        "NSPhotoLibraryUsageDescription": "Robertito´s CookBook accede a tu galería para importar y escanear fotografías de tus recetas.",
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "comgooglemaps-x-callback",
          "googlegmail"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F2EB",
        "foregroundImage": "./assets/images/chef.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/chef.png",
      "name": "Robertito´s CookBook",
      "shortName": "CookBook",
      "lang": "es",
      "themeColor": "#F5F5F7",
      "backgroundColor": "#F5F5F7"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F7",
          "image": "./assets/images/chef.png",
          "imageWidth": 140
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
